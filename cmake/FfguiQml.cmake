# ffgui_add_qml_module(): one call per QML module.
#
#   ffgui_add_qml_module(ffgui_theme
#       URI FFgui.Theme
#       QML_FILES Theme.qml Metrics.qml
#       SINGLETONS Theme.qml Metrics.qml
#       [SOURCES foo.cpp foo.h]          C++ types (QML_ELEMENT)
#       [RESOURCES data.json]
#       [LIBRARIES ffgui_core]           linked PRIVATE
#       [IMPORTS FFgui.Theme])           modules other modules see through this one
#
# Every module is a static library with a static plugin. QT_QML_OUTPUT_DIRECTORY
# puts all of them under ${CMAKE_BINARY_DIR}/qml, so qmllint, qmlcachegen and
# the tests resolve imports between them. ffgui_link_qml_plugins() links every
# plugin into an executable and writes the matching Q_IMPORT_QML_PLUGIN lines.

set(QT_QML_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/qml)

function(ffgui_add_qml_module target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG ""
        "URI" "QML_FILES;SINGLETONS;SOURCES;RESOURCES;LIBRARIES;IMPORTS;DEPENDENCIES")

    if(ARG_SINGLETONS)
        set_source_files_properties(${ARG_SINGLETONS} PROPERTIES QT_QML_SINGLETON_TYPE TRUE)
    endif()

    qt_add_library(${target} STATIC)
    qt_add_qml_module(${target}
        URI ${ARG_URI}
        VERSION 1.0
        QML_FILES ${ARG_QML_FILES}
        SOURCES ${ARG_SOURCES}
        RESOURCES ${ARG_RESOURCES}
        IMPORTS ${ARG_IMPORTS}
        DEPENDENCIES ${ARG_DEPENDENCIES}
    )
    target_link_libraries(${target} PRIVATE Qt6::Quick ${ARG_LIBRARIES})

    string(REPLACE "." "_" plugin_class "${ARG_URI}")
    set_property(GLOBAL APPEND PROPERTY FFGUI_QML_PLUGINS ${target}plugin)
    set_property(GLOBAL APPEND PROPERTY FFGUI_QML_PLUGIN_CLASSES ${plugin_class}Plugin)
endfunction()

# Links every module added so far (plus Quilt) into `target`, and generates
# ffgui_qml_plugins.h with one Q_IMPORT_QML_PLUGIN per module. Call it after
# all modules have been added.
function(ffgui_link_qml_plugins target)
    get_property(plugins GLOBAL PROPERTY FFGUI_QML_PLUGINS)
    get_property(classes GLOBAL PROPERTY FFGUI_QML_PLUGIN_CLASSES)
    target_link_libraries(${target} PRIVATE quiltplugin ${plugins})

    set(lines "// Generated by ffgui_link_qml_plugins(). Do not edit.\n#pragma once\n#include <QtQml/qqmlextensionplugin.h>\n\nQ_IMPORT_QML_PLUGIN(QuiltPlugin)\n")
    foreach(cls IN LISTS classes)
        string(APPEND lines "Q_IMPORT_QML_PLUGIN(${cls})\n")
    endforeach()
    set(dir ${CMAKE_CURRENT_BINARY_DIR}/${target}_plugins)
    file(GENERATE OUTPUT ${dir}/ffgui_qml_plugins.h CONTENT "${lines}")
    target_include_directories(${target} PRIVATE ${dir})
endfunction()
